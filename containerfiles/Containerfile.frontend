FROM stagex/pallet-nodejs@sha256:5c96b25c18713976497a21c770057f2179c5014c5a025a02d2df9041d8f861f6 AS pallet-nodejs
FROM stagex/core-npm@sha256:fa8e48af8e76931eadb68acd610358363095eb393c607672570b15746d796a39 AS npm
FROM stagex/core-git@sha256:ecd1de421f467072a76de5a38fce61dd0afb2ddd2c48d73c21effb5ad76342fb AS git
FROM stagex/core-curl@sha256:fa58ff1a1c32677ce3034e69a2ee40081c799d6df68a7b1d5d480501de779030 AS curl
FROM stagex/core-busybox@sha256:e4a30addc8939c8e232472de904d1d9e97fc2e735fca9a9701ce49db04c6c181 AS busybox
FROM stagex/core-libzstd@sha256:bfe96f975a2a2a7a48aeb418b44accc79dd26d601a94d9f02b0562eaa0f89fdd AS libzstd

FROM pallet-nodejs AS frontend-deps

COPY --from=npm . /
COPY --from=git . /
COPY --from=curl . /
COPY --from=libzstd . /
COPY --from=busybox . /

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./

RUN npm ci

FROM frontend-deps AS npm-audit

RUN npm audit --audit-level=high

FROM frontend-deps AS builder

COPY frontend/ ./

EXPOSE 3000

ENTRYPOINT []
CMD ["/usr/bin/npm", "run", "dev"]

FROM builder AS static-builder

ARG VITE_PADDLE_SANDBOX

ENV ENVIRONMENT=production
ENV NODE_ENV=production

RUN VITE_PADDLE_SANDBOX="${VITE_PADDLE_SANDBOX}" /usr/bin/npm run build

FROM scratch AS static

COPY --from=static-builder /app/dist /
