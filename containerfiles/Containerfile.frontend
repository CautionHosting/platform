FROM stagex/pallet-nodejs@sha256:5c96b25c18713976497a21c770057f2179c5014c5a025a02d2df9041d8f861f6 AS pallet-nodejs
FROM stagex/core-npm@sha256:fa8e48af8e76931eadb68acd610358363095eb393c607672570b15746d796a39 AS npm
FROM stagex/core-git@sha256:ecd1de421f467072a76de5a38fce61dd0afb2ddd2c48d73c21effb5ad76342fb AS git
FROM stagex/core-curl@sha256:fa58ff1a1c32677ce3034e69a2ee40081c799d6df68a7b1d5d480501de779030 AS curl
FROM stagex/core-busybox@sha256:e4a30addc8939c8e232472de904d1d9e97fc2e735fca9a9701ce49db04c6c181 AS busybox
FROM stagex/core-libzstd@sha256:bfe96f975a2a2a7a48aeb418b44accc79dd26d601a94d9f02b0562eaa0f89fdd AS libzstd
FROM stagex/pallet-gcc-gnu-busybox@sha256:67f4a035c680065fc0278517594ab07bf1b9416dc054508a8893ca20df04e415 AS gcc

FROM pallet-nodejs AS frontend-packages

COPY --from=npm . /
COPY --from=git . /
COPY --from=curl . /
COPY --from=libzstd . /
COPY --from=busybox . /
COPY --from=gcc /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./

FROM frontend-packages AS frontend-deps

RUN npm ci

FROM frontend-packages AS npm-audit

ENTRYPOINT ["timeout", "300", "npm", "audit", "--package-lock-only", "--include=dev", "--include=optional", "--audit-level=high"]

FROM frontend-deps AS builder

COPY frontend/ ./

EXPOSE 3000

ENTRYPOINT []
CMD ["/usr/bin/npm", "run", "dev"]

FROM frontend-deps AS sentry-uploader

COPY frontend/build/sentry.js ./build/sentry.js
COPY frontend/scripts/upload-sentry-sourcemaps.js frontend/scripts/validate-sentry-artifacts.js ./scripts/

FROM builder AS static-builder

ARG VITE_PADDLE_SANDBOX
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ARG VITE_SENTRY_RELEASE

ENV ENVIRONMENT=production
ENV NODE_ENV=production

RUN --network=none VITE_PADDLE_SANDBOX="${VITE_PADDLE_SANDBOX}" \
    VITE_SENTRY_DSN="${VITE_SENTRY_DSN}" \
    VITE_SENTRY_ENVIRONMENT="${VITE_SENTRY_ENVIRONMENT}" \
    VITE_SENTRY_RELEASE="${VITE_SENTRY_RELEASE}" /usr/bin/npm run build

FROM scratch AS frontend-artifacts

COPY --from=static-builder /app/dist /dist
COPY --from=static-builder /app/sentry-artifacts /sentry-artifacts

FROM pallet-nodejs AS validated-frontend

COPY --from=gcc /usr/lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1
COPY frontend/package.json /validator/package.json
COPY frontend/build/sentry.js /validator/build/sentry.js
COPY frontend/scripts/validate-sentry-artifacts.js /validator/scripts/validate-sentry-artifacts.js
COPY --from=frontend-artifacts / /retained/

ARG VITE_PADDLE_SANDBOX
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ARG VITE_SENTRY_RELEASE

RUN --network=none ["/usr/bin/node", "/validator/scripts/validate-sentry-artifacts.js", "/retained/dist", "/retained/sentry-artifacts"]

FROM scratch AS static

COPY --from=validated-frontend /retained/dist /
