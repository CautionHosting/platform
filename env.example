# Copy to $HOME/.config/caution/.env and keep private (chmod 600).
# Docker env-file syntax: literal KEY=value, no shell expansion or inline comments.
# See containerfiles/README.md for automatic make up releases and recovery.
ENVIRONMENT=development

# AWS Configuration (required)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary credentials also require AWS_SESSION_TOKEN.
# AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
AWS_REGION=us-west-2
TERRAFORM_STATE_BUCKET=
# Required in production; from infra-bootstrap output. Leave unset to disable managed DNS in development.
CAUTION_APPS_DNS_ZONE_ID=
# Optional; defaults to apps.caution.sh. Must name the Route53 hosted zone above.
CAUTION_APPS_DNS_SUFFIX=apps.caution.sh

# AWS Configuration (optional - have defaults)
# EIF_S3_BUCKET=
# SSH_KEY_NAME=

# Service URLs
API_SERVICE_URL=http://api:8080
EMAIL_SERVICE_URL=http://email:8082
FRONTEND_URL=http://localhost:8000
# Public Caution dashboard/application domain used in generated links.
CAUTION_DOMAIN=dashboard.caution.co
GIT_HOSTNAME=localhost:2222
VITE_PROXY_TARGET=http://gateway:8080
# Optional comma-separated allowlist for custom dev hostnames, e.g. app.example.test,.example.test
VITE_ALLOWED_HOSTS=

# Postgres Configuration (used by systemd caution-postgres.service)
POSTGRES_DB=caution
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Gateway Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/caution
DB_MAX_CONNECTIONS=25
SSH_PORT=2222
SSH_HOST_KEY_PATH=/var/cache/caution/ssh_host_ed25519_key
FRONTEND_DIR=/app/frontend

# WebAuthn Configuration
RP_ID=localhost
RP_DISPLAY_NAME=Caution
RP_ORIGINS=http://localhost:8000,http://localhost:8080
SESSION_TIMEOUT_HOURS=24

# Internal Service Authentication (required for production)
# Shared secret between gateway and API for internal service-to-service auth
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=

# Email Service Configuration
EMAIL_TEST_MODE=true
SMTP_HOST=smtp.migadu.com
SMTP_PORT=587
SMTP_USERNAME=your-email@yourdomain.com
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Caution
CAPACITY_ALERT_TO=team@yourdomain.com

# Enclave Configuration (optional)
CAUTION_ENCLAVE_SOURCE=
CAUTION_ENCLAVE_VERSION=

# Enclave dependency pins (optional)
# Leave unset to use the candidate API image's defaults. make up resolves them with
# its packaged prepare-components --print-inputs and records the exact pins.
# Overrides must be full lowercase 40-character Git commits, not branches/tags.
# ENCLAVEOS_COMMIT=
# BOOTPROOF_COMMIT=
# STEVE_COMMIT=
# LOCKSMITH_COMMIT=

# Automatic platform release: make up prepares/publishes verified components and
# activates the generated digest with the matching service images and source pins.
# API deployment defaults to prebuilt; leaving the digest unset is NOT source mode.
COMPONENT_BUILD_MODE=prebuilt
# Explicit fallback: make up COMPONENT_BUILD_MODE=source
# That release clears stale digest/bucket selection in its generated env overlay.
# COMPONENT_SET_SHA256 is generated under ~/.config/caution/releases/<id>/;
# do not copy a hash here or edit the generated components.env manually.
# Optional existing component bucket; otherwise use EIF_S3_BUCKET, or the existing
# caution-eif-storage-<AWS_ACCOUNT_ID> bucket when EIF_S3_BUCKET is unset.
# COMPONENTS_S3_BUCKET=
# Preparation reads this .env and forwards exported AWS_* credentials (including
# AWS_SESSION_TOKEN); it does not mount host AWS profiles/SSO files. Runtime service
# credentials still come from this .env; shell exports do not update it.
# Publisher needs existing prefix-scoped ListBucket/GetObject/PutObject access to
# components/v1/. make up never creates buckets or changes IAM/roles/policies.
# Sufficient existing deployment credentials may be reused; no new role is required.
# Same-bucket managed consumers use only verified GETs. For a different source
# bucket, set infra-bootstrap's components_source_bucket_name to the same name and
# separately review/apply that opt-in IAM before activation. This relay policy does
# not authorize publishing build indexes. Cross-account sources also need their
# owner's bucket policy to allow the platform principal. Builders read EIF_S3_BUCKET.
# BYOC uses platform credentials for source GETs and separate customer credentials
# for GetObject/PutObject on the customer's components/v1/ prefix. Relay uses
# If-None-Match: * and exact read-back, with no destination ListBucket requirement.
# AccessDenied/corruption fail closed, never authorize repair or replacement hashes.
# Preparation failure runs no migrations/restarts. Incomplete activation blocks the
# next make up until make recover-release; recovery does NOT roll back the database.
# Verify schema compatibility before recovery. No cleanup/retention/lifecycle changes.

# Data Directory (optional - defaults to /var/cache/caution/ in containers)
# For local dev, set to a local path like ./caution-data
CAUTION_DATA_DIR=

# Cloud Credentials Encryption (required for managed on-prem deployments)
# Generate with: openssl rand -base64 32
CAUTION_ENCRYPTION_KEY=

# Paddle Billing (optional - required for payment collection)
# Get these from https://sandbox-vendors.paddle.com/ (sandbox) or https://vendors.paddle.com/ (production)
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
# Create a product + price in Paddle dashboard; use the price ID here
PADDLE_SETUP_PRICE_ID=
# Optional preset credit bundle price IDs
PADDLE_CREDITS_PRICE_ID_1000=
PADDLE_CREDITS_PRICE_ID_5000=
PADDLE_CREDITS_PRICE_ID_10000=
# Frontend: set to 'true' for sandbox, 'false' for production
VITE_PADDLE_SANDBOX=true

# Dedicated Builder (required - builds EIFs on ephemeral EC2 instances)
BUILDER_AMI_ID=
BUILDER_SECURITY_GROUP_ID=
BUILDER_SUBNET_ID=
BUILDER_INSTANCE_PROFILE=
BUILDER_TIMEOUT_SECS=1200
DEPLOYMENT_HEALTH_TIMEOUT_SECS=600

# Metering Configuration
METERING_SERVICE_URL=http://metering:8083
METERING_INTERVAL_SECS=60
