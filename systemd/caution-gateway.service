# user systemd file for managing Caution gateway

[Unit]
Description=Caution gateway service
Requires=caution-network.service
After=caution-api.service caution-postgres.service caution-network.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f gateway
ExecStartPre=/usr/bin/mkdir -p %h/.config/caution/policies
ExecStart=/usr/bin/python3 %h/.local/lib/caution/platform_env.py run --name gateway -p 8000:8080 -p 2222:2222 --network caution-network -v caution-data-dir:/var/cache/caution -v %h/.config/caution/policies:/run/config:ro caution-gateway
ExecStop=/usr/bin/docker stop gateway

[Install]
WantedBy=default.target
