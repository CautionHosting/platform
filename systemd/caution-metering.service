# user systemd file for managing Caution metering

[Unit]
Description=Caution Metering service
Requires=caution-network.service
After=caution-postgres.service caution-network.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f metering
ExecStart=/usr/bin/python3 %h/.local/lib/caution/platform_env.py run --name metering --network caution-network -v %h/.config/caution/prices.json:/app/prices.json:ro caution-metering
ExecStop=/usr/bin/docker stop metering

[Install]
WantedBy=default.target
